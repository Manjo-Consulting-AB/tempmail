# Mail Shield — example environment file.
# Copy to .env.development / .env.production (see config.php for where it is
# searched for) and fill in real values. Never commit the copies.

# Database
DB_HOST=db
DB_NAME=tempmail
DB_USER=tempmail_user
DB_PASSWORD=

# Mail
EMAIL_DOMAIN=example.com
BASE_URL=http://localhost:8085/

# IMAP intake
IMAP_SERVER={imap.example.com:993/imap/ssl}INBOX
IMAP_USER=
IMAP_PASSWORD=
IMAP_ENABLED=true

# Client IP behind a proxy (ip_utils.php, getVisitorIp()).
# By default only REMOTE_ADDR is used and every forwarding header is ignored.
# TRUSTED_PROXIES: comma-separated IPs/CIDRs of YOUR proxies/load balancers,
# e.g. 127.0.0.1,10.0.0.0/8 - X-Forwarded-For is then walked from the right.
# TRUST_CLOUDFLARE=true: also trust Cloudflare's edge ranges and read
# CF-Connecting-IP. Set one of these if the site sits behind a proxy, or every
# visitor appears as the proxy's IP (shared rate limits and IP blocks).
#TRUSTED_PROXIES=
#TRUST_CLOUDFLARE=

# Diagnostics
DEBUG_MODE=false
LOG_LEVEL=INFO

# Paddle Billing — pricing.php (PricePreview + overlay checkout).
# PADDLE_ENVIRONMENT is required and has no default: "sandbox" or "production".
# PADDLE_CLIENT_TOKEN is a *client-side* token (Paddle > Developer tools >
# Authentication): test_… for sandbox, live_… for production. It is printed
# into the page, so it must never be a server-side API key (pdl_…).
# The price IDs in pricing_tiers.php belong to the same environment.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_
# Secret of the notification destination pointing at paddle_webhook.php
# (Developer tools > Notifications), pdl_ntfset_…. Server-side only.
PADDLE_WEBHOOK_SECRET=
# Server-side API key for the customer portal (Manage billing), created under
# Developer tools > Authentication with ONLY the "Customer portal sessions:
# write" permission. pdl_sdbx_apikey_… (sandbox) / pdl_live_apikey_… (live).
# Never printed into a page.
PADDLE_API_KEY=

# Admin tools (log_viewer.php): comma-separated pro_users ids. Empty = nobody.
ADMIN_USER_IDS=
