# TempMail Apache Configuration
# Säkerhetsinställningar och URL-hantering

# Aktivera mod_rewrite
RewriteEngine On

# MCP-endpointen (#321) autentiserar med `Authorization: Bearer …`. Apache med
# CGI/FastCGI tar bort det huvudet innan PHP startar, så det kopieras in i
# HTTP_AUTHORIZATION här (mcp.php läser även REDIRECT_HTTP_AUTHORIZATION, för
# den interna omdirigeringen). CGIPassAuth hade varit renare, men det är en
# directive som AllowOverride kan förbjuda — och då svarar hela trädet 500.
# mod_rewrite är redan på och fungerar bevisligen här.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Directories that exist only for development, documentation or CLI use and
# must never be fetched over HTTP. PHP still reads them from the filesystem
# (require/include/file_get_contents are unaffected by .htaccess):
#   vendor/       - Composer packages, loaded via vendor/autoload.php
#   tests/        - CLI regression suites (no longer deployed, but an older
#                   upload may still sit on the server since rsync has no --delete)
#   documentaion/ - internal docs (not deployed either)
#   client/       - Client Agent source. Downloads go through
#                   client_agent_download.php / client_agent_install_download.php
#                   and the API through client_agent_api.php, all of which
#                   read client/ from disk; nothing requests client/ by URL.
# In a per-directory .htaccess the pattern is matched without a leading slash.
RewriteRule ^(?:vendor|tests|documentaion|client)(?:/|$) - [F,L]

# OAuth-metadatadokumenten (#331 steg 5/6). En MCP-klient hittar
# auktoriseringsservern härifrån; oauth_metadata.php svarar med rätt dokument
# beroende på sökvägen (RFC 9728 för resursen, RFC 8414 för servern, plus
# OpenID-anslutningens alias). Reglerna måste ligga före dotfile-spärren
# nedan, som annars nekar allt som börjar med en punkt — den undantar redan
# .well-known/, och den exemptionen är kvar oförändrad.
RewriteRule ^\.well-known/oauth-protected-resource(?:/mcp)?/?$ oauth_metadata.php [L]
RewriteRule ^\.well-known/oauth-authorization-server/?$ oauth_metadata.php [L]
RewriteRule ^\.well-known/openid-configuration/?$ oauth_metadata.php [L]

# Any path component that starts with a dot (.git/, .github/, .claude/, ...) is
# refused, except .well-known/ which ACME (Let's Encrypt) and other RFC 8615
# consumers need. Dotfiles themselves are also refused by the FilesMatch below.
RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,L]

# /favicon.ico är adressen webbläsare, Googles favicon-crawler och RSS-läsare
# provar när de inte läser sidans <link rel="icon">; filen ligger i
# assets/images/ (se partials/favicons.php).
RewriteRule ^favicon\.ico$ assets/images/favicon.ico [L]

# /sitemap.xml serveras av sitemap.php (genererad, se sitemap.php)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Gränssnittsspråk (i18n.php, documentaion/I18N.md). /sv/ och /sv/<sida>.php
# serveras av samma fil som den engelska sidan; i18nBootstrap() läser prefixet
# ur REQUEST_URI och skickar en 302 till den vanliga adressen när sidan inte
# finns på det språket (inte översatt, eller språket är avslaget). Bara de
# språkkoder koden stöder (i18nSupportedLocales(), utom engelska) står här, så
# inget annat på sajten kan tas för ett prefix — lägg till koden här när ett
# språk läggs till.
RewriteRule ^(sv)/?$ index.php [L]
RewriteRule ^(sv)/([A-Za-z0-9_-]+\.php)$ $2 [L,QSA]

# MCP-endpointen (#321). /mcp är adressen användarna får och den som står i
# klienternas konfiguration; mcp.php är filen som svarar.
RewriteRule ^mcp/?$ mcp.php [L]

# Inbjudningslänken /invite/<kod> serveras av invite.php (referrals, epic #387).
RewriteRule ^invite/([^/]+)/?$ invite.php?code=$1 [L,QSA]

# OAuth-klientregistrering (#331). En OAuth-klient (Claude.ai, Claude Code)
# registrerar sig själv här innan den skickar användaren till samtyckessidan;
# oauth_register.php svarar. Se oauth_server.php.
RewriteRule ^oauth/register/?$ oauth_register.php [L]

# OAuth-tokenväxling och återkallning (#331 steg 2/6). Klienten byter sin
# kod mot en åtkomsttoken här och återkallar den senare; oauth_token.php och
# oauth_revoke.php svarar. Se oauth_server.php.
RewriteRule ^oauth/token/?$ oauth_token.php [L]
RewriteRule ^oauth/revoke/?$ oauth_revoke.php [L]

# OAuth-samtyckessidan (#331 steg 3/6). Klienten skickar hit användaren, som
# loggar in och svarar ja eller nej; oauth_authorize.php svarar. Se
# oauth_server.php och after_login.php (inloggningen måste kunna komma tillbaka
# hit).
RewriteRule ^oauth/authorize/?$ oauth_authorize.php [L]

# Sätt standardindex-fil
DirectoryIndex index.php

# Blockera åtkomst till känsliga filer
<FilesMatch "\.(env|log|sql|backup)$">
    Require all denied
</FilesMatch>

# Blockera åtkomst till Docker-filer
<FilesMatch "^(Dockerfile|docker-compose)">
    Require all denied
</FilesMatch>

# Every dotfile: .env.production (and any other .env.<env> - the rule above
# only matches names ending in .env), .env.example, .gitignore, .semgrepignore,
# .htaccess itself, editor leftovers such as .foo.php.swp, ...
# <FilesMatch> tests the basename of the requested file, not the directories
# in its path, so /.well-known/acme-challenge/<token> (basename <token>) is
# not affected; the .well-known directory is also exempted in the rewrite
# rule above.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Repository metadata and documentation. blog/*.md is rendered by blog.php,
# which reads the files from disk, so the raw Markdown never needs to be served.
<FilesMatch "(\.md|\.lock|\.dist|\.example|^composer\.json)$">
    Require all denied
</FilesMatch>

# Backup and editor swap files (foo.php.bak, foo.php.swp, foo.php~, ...),
# which would otherwise be served as plain text with the PHP source in them.
<FilesMatch "(\.(bak|swp|swo|orig|old)|~)$">
    Require all denied
</FilesMatch>

# Sätt korrekt MIME-types
AddType text/css .css
AddType application/javascript .js

# Security headers. No Content-Security-Policy here on purpose: it needs its
# own rollout. SAMEORIGIN still lets the site frame its own pages.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # HSTS only on HTTPS responses. No includeSubDomains/preload: other
    # manjo.me hosts have not been audited for HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
